@echo off
chcp 65001 >nul
title GitHub Token Push
cd /d "%~dp0"

echo ========================================================================
echo   🚀 ОТПРАВКА НА GITHUB ЧЕРЕЗ ТОКЕН (100%% НАДЕЖНЫЙ СПОСОБ)
echo ========================================================================
echo.
echo 1. Откройте ссылку (я также открыл ее для вас):
echo    https://github.com/settings/tokens/new
echo.
echo 2. В поле "Note" напишите: render
echo 3. Поставьте галочку на "repo"
echo 4. Прокрутите вниз и нажмите зеленую кнопку "Generate token"
echo 5. Скопируйте токен (начинается на ghp_...)
echo.
echo ------------------------------------------------------------------------
set /p TOKEN="Вставьте сюда токен и нажмите Enter: "
echo ------------------------------------------------------------------------
echo.
echo Отправка файлов в https://github.com/venstogram-del/venstogram ...
echo.

git push https://%TOKEN%@github.com/venstogram-del/venstogram.git main

echo.
if %errorlevel% equ 0 (
    echo ========================================================================
    echo  УСПЕХ! Проект полностью загружен на GitHub!
    echo ========================================================================
) else (
    echo ========================================================================
    echo  Ошибка. Убедитесь, что токен скопирован полностью и без пробелов.
    echo ========================================================================
)
echo.
pause
